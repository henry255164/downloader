{
  "manifest_version": 3,
  "name": "Media Downloader Plugin",
  "version": "1.0",
  "description": "Download media from YouTube, Twitter, and Instagram using a local Go service.",
  "permissions": [
    "contextMenus",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
